# Copier ce fichier en .env.local et remplir avec les vraies valeurs Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_ENV=sandbox
VITE_ENABLE_LOCAL_AUTH_FALLBACK=false
VITE_AUTH_USE_EMULATOR=false

# Optionnel : en dev sandbox, Sosson utilise l'emulateur SQL Connect automatiquement.
# Passez VITE_DATACONNECT_ENABLED=false pour revenir aux seeds front uniquement.
VITE_DATACONNECT_ENABLED=true
VITE_DATACONNECT_USE_EMULATOR=
VITE_DATACONNECT_EMULATOR_HOST=127.0.0.1
VITE_DATACONNECT_EMULATOR_PORT=9399

# Optionnel : l'emulateur Firebase Auth est opt-in.
# Le login Google sandbox reel exige VITE_AUTH_USE_EMULATOR=false.
VITE_AUTH_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
