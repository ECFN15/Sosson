rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // V1 démo : accès authentifié uniquement
    // À renforcer post-démo avec les rôles (gerant / assistante / chef_chantier)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
